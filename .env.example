APP_ENV=development
SECRET_KEY=paste-a-long-random-value-here
# DATABASE_URL=postgresql://user:password@host/dbname

# ---- AI connection (add these to your own .env file, never to Git) ----
# AI_PROVIDER can be: openai or gemini
AI_PROVIDER=openai
OPENAI_API_KEY=paste-your-openai-api-key-here
# Copy the exact model name from OpenAI's model list (platform.openai.com/docs/models)
OPENAI_MODEL=paste-the-model-name-here
# How long to wait for the AI, in seconds
AI_TIMEOUT_SECONDS=180

# ---- Free Gemini option: ONLY for testing with fictional data ----
# GEMINI_API_KEY=paste-your-google-ai-studio-key-here
# GEMINI_MODEL=paste-the-model-name-here

# ---- Online hosting (production) ----
# APP_ENV=production
# SECRET_KEY must be at least 32 random characters in production
# Set TRUST_PROXY=1 ONLY when the hosting provider puts a proxy in front of the app (PythonAnywhere does)
# TRUST_PROXY=1
